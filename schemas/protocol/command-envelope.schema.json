{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://susong.local/schemas/protocol/command-envelope.schema.json",
  "title": "Susong client command envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "type", "requestId", "commandId", "payload"],
  "properties": {
    "protocolVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "Major version compatibility is enforced by the server."
    },
    "type": {
      "type": "string",
      "enum": [
        "hello",
        "auth",
        "login",
        "refresh",
        "logout",
        "create_room",
        "join_room",
        "leave_room",
        "ready",
        "start_round",
        "begin_playing",
        "action",
        "settle_round",
        "next_round",
        "disband_room",
        "reconnect",
        "subscribe",
        "unsubscribe",
        "ping"
      ]
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "commandId": {
      "type": "string",
      "format": "uuid"
    },
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "roomId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "roomVersion": {
      "type": "integer",
      "minimum": 0
    },
    "clientTime": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
