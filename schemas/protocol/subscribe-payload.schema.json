{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://susong.local/schemas/protocol/subscribe-payload.schema.json",
  "title": "Room subscription payload",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "roomId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "allowUnseated": { "type": "boolean" }
  }
}
