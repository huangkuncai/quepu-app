# Development-safe defaults. Do not put secrets in this file.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# `stub` is allowed only for local development/test/staging. Production must use
# an external reviewed identity provider once BE-103 is implemented.
AUTH_MODE=stub

# Persistence stays in memory by default. Set postgres only after applying all
# migrations and supplying a reachable PostgreSQL instance.
PERSISTENCE_BACKEND=memory
DATABASE_URL=
REDIS_URL=

WS_MAX_PAYLOAD_BYTES=65536
WS_MAX_BUFFERED_BYTES=1048576
WS_MAX_QUEUE_MESSAGES=256
WS_HEARTBEAT_INTERVAL_MS=30000
WS_HEARTBEAT_TIMEOUT_MS=10000
WS_RATE_LIMIT_PER_MINUTE=120
WS_RECONNECT_GRACE_MS=120000
# Comma-separated exact browser origins. Native clients may omit Origin.
ALLOWED_ORIGINS=
ROOM_EVENT_RETENTION=10000

# Keep both disabled until the corresponding rule engine and ledger gates pass.
FEATURE_REAL_RULES=false
FEATURE_REAL_DIAMONDS=false
